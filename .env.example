# Server-only Supabase credentials. Never prefix either with NEXT_PUBLIC_.
SPB_PROJECT_ID=
SPB_SECRET_KEY=
# Required only for applying migrations; it must include database_write permission.
SPB_ACCESS_TOKEN=
SUPABASE_ARTIFACT_BUCKET=skill-artifacts
ARTIFACT_MAX_BYTES=52428800
WORKSPACE_ROOT=data/workspaces
JOB_POLL_INTERVAL=2
# fixture keeps V1.1 deterministic. Set live only after configuring engine CLIs.
SKILL_FACTORY_ENGINE_MODE=fixture
AREX_DISCO_BIN=disco
SKILLALCHEMY_AGENT_BIN=codex
