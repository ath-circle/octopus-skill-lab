# Server-only Supabase credentials. Never prefix either with NEXT_PUBLIC_.
SPB_PROJECT_ID=
SPB_SECRET_KEY=
# Required only for applying migrations; it must include database_write permission.
SPB_ACCESS_TOKEN=
SUPABASE_ARTIFACT_BUCKET=skill-artifacts
ARTIFACT_MAX_BYTES=52428800
WORKSPACE_ROOT=data/workspaces
JOB_POLL_INTERVAL=2
# fixture keeps V1.1 deterministic. Set live only after configuring engine CLIs.
SKILL_FACTORY_ENGINE_MODE=fixture
AREX_DISCO_BIN=disco
SKILLALCHEMY_AGENT_BIN=codex
# Path to the deliberately installed upstream SkillAlchemy package (contains SKILL.md).
SKILLALCHEMY_SKILL_PATH=
# Path to an intentionally installed upstream Anthropic Skill Creator package.
# Until this exists and contains SKILL.md, the skillcreator adapter remains unavailable.
SKILLCREATOR_AGENT_BIN=codex
SKILLCREATOR_SKILL_PATH=
# Real holdout benchmark. `codex` runs executor and blind grader as separate invocations.
CODEX_BIN=codex
CODEX_BENCHMARK_TIMEOUT_SECONDS=300
BENCHMARK_WORKSPACE_ROOT=data/evaluations
# Local Phoenix is optional telemetry: `PHOENIX_HOST=127.0.0.1 PHOENIX_PORT=6006 uv run phoenix serve`
PHOENIX_BASE_URL=http://127.0.0.1:6006
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006/v1/traces
PHOENIX_PROJECT_NAME=octopus-skill-lab
# Optional repeatable regression suites; disabled unless an operator configures Promptfoo providers.
PROMPTFOO_ENABLED=false
PROMPTFOO_BIN=promptfoo
